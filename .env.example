# Copy this file to .env (in the repo root) and fill in the values.
# Never commit .env. On Render, set these in the service's Environment tab.

# MongoDB Atlas connection string, including the database name (taskwise).
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/taskwise?retryWrites=true&w=majority

# Secret used to sign the session cookie. Use 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-string

# OAuth 2.0 Client ID (Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Comma-separated emails that are always admins. They can promote others in the app.
ADMIN_EMAILS=admin@example.com

# "development" locally, "production" on Render (enables secure cookies).
NODE_ENV=development

# Port for the Express server (Render sets this automatically).
PORT=4000

# Optional: Web Push keys so reminders arrive while TaskWise is closed.
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address sent to push services (mailto: or https: URL).
VAPID_SUBJECT=mailto:admin@example.com
